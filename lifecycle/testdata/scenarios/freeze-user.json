	},
	"queries": [
		{
			"contains": "FROM User WHERE Username IN ('freeze@example.com')",
			"records": [
				{
					"Id": "005xx0000000001AAA",
					"IsActive": true,
					"Name": "Freeze User",
					"Username": "freeze@example.com"
				}
			]
		},
		{
			"contains": "FROM UserLogin",
			"records": [
				{
					"Id": "0LLxx0000000001AAA",
					"UserId": "005xx0000000001AAA",
					"IsFrozen": false
				}
			]
		}
	],
	"apply": true
}
