{
	"source": "lifecycle.test.ts: restores only missing snapshot assignments and skips DML in dry-run",
	"command": "restore",
	"options": {
		"snapshotPath": "testdata/files/restore-snapshot.json"
	},
	"queries": [
		{
			"contains": "FROM User WHERE Username IN ('restore@example.com')",
			"records": [
				{
					"Id": "005xx0000000200AAA",
					"IsActive": false,
					"Name": "Resolved User",
					"Username": "restore@example.com",
					"Email": "restore@example.com",
					"ProfileId": "00eProfile",
					"Profile": {
						"Name": "New Profile"
					},
					"UserRoleId": "00eRole",
					"UserRole": {
						"Name": "Support"
					}
				}
			]
		},
		{
			"contains": "FROM UserLogin",
			"records": [
				{
					"Id": "0LL200",
					"UserId": "005xx0000000200AAA",
					"IsFrozen": true
				}
			]
		},
		{
			"contains": "FROM PermissionSetAssignment WHERE AssigneeId",
			"records": [
				{
					"Id": "0Pa200",
					"AssigneeId": "005xx0000000200AAA",
					"PermissionSetId": "0PSExisting",
					"PermissionSetGroupId": null,
					"PermissionSet": {
						"IsOwnedByProfile": false,
						"Name": "Strip_Perms",
						"Label": "Strip Permissions"
					}
				}
			]
		},
		{
			"contains": "FROM GroupMember",
			"records": [
				{
					"Id": "0GM200",
					"GroupId": "00GExistingPublic",
					"UserOrGroupId": "005xx0000000200AAA",
					"Group": {
						"Type": "Regular"
					}
				}
			]
		},
		{
			"contains": "FROM PermissionSetLicenseAssign",
			"records": []
		},
		{
			"contains": "FROM PermissionSet WHERE Name IN",
			"records": [
				{
					"Id": "0PSExisting",
					"Name": "Existing_Perms"
				},
				{
					"Id": "0PSMissing",
					"Name": "Missing_Perms"
				}
			]
		},
		{
			"contains": "FROM PermissionSetGroup",
			"records": [
				{
					"Id": "0PGMissing",
					"DeveloperName": "Missing_Group"
				}
			]
		},
		{
			"contains": "FROM Group WHERE DeveloperName IN ('Existing_Public','Missing_Public')",
			"records": [
				{
					"Id": "00GExistingPublic",
					"DeveloperName": "Existing_Public"
				},
				{
					"Id": "00GMissingPublic",
					"DeveloperName": "Missing_Public"
				}
			]
		},
		{
			"contains": "FROM Group WHERE DeveloperName IN ('Missing_Queue')",
			"records": [
				{
					"Id": "00GMissingQueue",
					"DeveloperName": "Missing_Queue"
				}
			]
		},
		{
			"contains": "FROM PermissionSetLicense",
			"records": [
				{
					"Id": "0PLicMissing",
					"DeveloperName": "MissingLicense"
				}
			]
		}
	],
	"apply": true
}
