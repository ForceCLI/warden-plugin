{
	"source": "lifecycle.test.ts: keeps failed strip targets aligned with later successes",
	"command": "strip",
	"options": {
		"usersPath": "testdata/files/strip-users.json",
		"noDeactivate": true,
		"keepPermsets": true,
		"keepPermsetGroups": true,
		"keepLicenses": true,
		"keepPublicGroups": true,
		"keepQueues": true
	},
	"queries": [
		{
			"contains": "FROM User WHERE Username IN ('missing@example.com','good@example.com')",
			"records": [
				{
					"Id": "005xx0000000005AAA",
					"IsActive": true,
					"Username": "good@example.com"
				}
			]
		},
		{
			"contains": "FROM UserLogin",
			"records": [
				{
					"Id": "0LLxx0000000005AAA",
					"UserId": "005xx0000000005AAA",
					"IsFrozen": false
				}
			]
		}
	],
	"apply": true
}
